# ------------------------------------------------------------------
# Copy this file to .env and fill in the values. Never commit .env.
# ------------------------------------------------------------------

PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000

# Database (docker-compose starts Postgres with pgvector for you)
DATABASE_URL=postgresql://handover:handover@localhost:5432/handover?schema=public

# Encrypts uploaded documents and Google tokens. REQUIRED. Make one with:  npm run gen:key
ENCRYPTION_KEY=

# AI: interview follow-ups and written, cited answers (Google Gemini: aistudio.google.com -> Get API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Embeddings ("meaning fingerprints") for search (dash.voyageai.com). Without it, search matches words only.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# Login: firebase (real) or dev (local testing only; refused in production)
AUTH_MODE=dev
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=

# Google Drive import (Google Cloud console → APIs & Services → Credentials → OAuth client, "Web application")
#   Authorised redirect URI: PUBLIC_BASE_URL/auth/google/callback      Also enable the "Google Drive API".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Invitation emails: console prints them here; postmark sends them
MAIL_PROVIDER=console
POSTMARK_SERVER_TOKEN=
MAIL_FROM=Handover <hello@yourdomain.com>

# Bump when you change the consent wording, so people read and sign the new version
CONSENT_VERSION=2026-11-06
# How close (0–1) a passage must be in meaning to be used. Below it, the answer is "I don't know".
MIN_RELEVANCE=0.2

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
WORKER_INLINE=true
